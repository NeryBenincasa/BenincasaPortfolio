---
---
<section style="min-height:100dvh;display:flex;flex-direction:column;position:relative;overflow:hidden;padding-top:4rem;">

  <!-- Background radial -->
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse 70% 55% at 65% 35%, rgba(125,29,63,0.2) 0%, transparent 65%);pointer-events:none;"></div>

  <!-- Vertical accent line -->
  <div style="position:absolute;left:2rem;top:0;bottom:0;width:1px;background:linear-gradient(to bottom, transparent 0%, rgba(125,29,63,0.4) 35%, rgba(196,149,106,0.2) 65%, transparent 100%);pointer-events:none;"></div>

  <!-- Main content — margin-top:auto lo empuja al fondo del flex container -->
  <div style="margin-top:auto;padding:0 2rem 3rem;max-width:72rem;width:100%;position:relative;">

    <!-- Eyebrow pill badge -->
    <div class="reveal" style="display:inline-flex;align-items:center;gap:0.5rem;border-radius:9999px;border:1px solid rgba(196,149,106,0.3);background:rgba(196,149,106,0.07);padding:0.35rem 0.9rem;margin-bottom:2rem;width:fit-content;">
      <span style="width:5px;height:5px;border-radius:50%;background:#C4956A;display:inline-block;animation:pulse-dot 2s infinite;flex-shrink:0;"></span>
      <span style="font-size:0.7rem;letter-spacing:0.2em;text-transform:uppercase;color:#C4956A;font-family:'Outfit',sans-serif;font-weight:500;white-space:nowrap;">Desarrollo web · AI-First</span>
    </div>

    <!-- Headline -->
    <h1 class="reveal reveal-delay-1" style="font-size:clamp(2.8rem,7.5vw,6.8rem);font-weight:500;color:#F2EDE6;max-width:15ch;margin-bottom:1.75rem;letter-spacing:-0.03em;line-height:1.08;">
      Tu negocio merece una buena
      <em style="color:#7D1D3F;font-style:italic;display:block;">casa en internet.</em>
    </h1>

    <!-- Subheadline -->
    <p class="reveal reveal-delay-2" style="font-size:clamp(0.95rem,1.4vw,1.15rem);color:#C8C0B5;max-width:46ch;line-height:1.75;margin-bottom:3rem;font-family:'Outfit',sans-serif;font-weight:300;">
      Diseño y desarrollo de sitios web que convierten visitas en clientes.
      Rápido, con criterio, sin aspecto genérico.
    </p>

    <!-- CTAs -->
    <div class="reveal reveal-delay-3" style="display:flex;align-items:center;gap:1.25rem;flex-wrap:wrap;margin-bottom:4rem;">
      <a
        href="#contacto"
        style="display:inline-flex;align-items:center;gap:0.6rem;background:#7D1D3F;color:#F2EDE6;text-decoration:none;padding:0.9rem 1.75rem;border-radius:9999px;font-size:0.82rem;letter-spacing:0.06em;text-transform:uppercase;font-weight:500;font-family:'Outfit',sans-serif;transition:all 0.4s cubic-bezier(0.32,0.72,0,1);"
        onmouseover="this.style.background='#A3264F';this.style.transform='scale(0.97)'"
        onmouseout="this.style.background='#7D1D3F';this.style.transform='scale(1)'"
      >
        Ver qué puedo hacer por vos
        <span style="display:inline-flex;align-items:center;justify-content:center;width:1.5rem;height:1.5rem;border-radius:50%;background:rgba(255,255,255,0.15);font-size:0.7rem;">↗</span>
      </a>
      <a
        href="#proceso"
        style="color:#C8C0B5;text-decoration:none;font-size:0.82rem;letter-spacing:0.08em;text-transform:uppercase;font-family:'Outfit',sans-serif;display:flex;align-items:center;gap:0.4rem;transition:all 0.3s cubic-bezier(0.32,0.72,0,1);"
        onmouseover="this.style.color='#F2EDE6';this.style.gap='0.7rem'"
        onmouseout="this.style.color='#C8C0B5';this.style.gap='0.4rem'"
      >
        Cómo trabajo <span>→</span>
      </a>
    </div>

    <!-- Stats -->
    <div class="reveal reveal-delay-4" style="display:flex;gap:0;border-top:1px solid rgba(125,29,63,0.2);flex-wrap:wrap;">
      {[
        { valor: "48hs", label: "Primera versión lista" },
        { valor: "95+", label: "PageSpeed score" },
        { valor: "100%", label: "Diseño a medida" },
      ].map((stat, i) => (
        <div style={`padding:1.5rem 2.5rem;${i > 0 ? 'border-left:1px solid rgba(125,29,63,0.2);' : ''}`}>
          <p style="font-family:'Playfair Display',serif;font-size:2rem;font-weight:500;color:#F2EDE6;line-height:1;">{stat.valor}</p>
          <p style="font-size:0.68rem;letter-spacing:0.12em;text-transform:uppercase;color:#7A7068;margin-top:0.4rem;font-family:'Outfit',sans-serif;">
            {stat.label}
          </p>
        </div>
      ))}
    </div>

  </div>

  <!-- Marquee strip — siempre al pie de la sección -->
  <div style="width:100%;border-top:1px solid rgba(125,29,63,0.2);border-bottom:1px solid rgba(125,29,63,0.2);padding:0.85rem 0;overflow:hidden;background:rgba(125,29,63,0.04);flex-shrink:0;">
    <div class="marquee-track" style="display:flex;gap:0;white-space:nowrap;width:max-content;animation:marquee 22s linear infinite;">
      {Array(3).fill(null).map(() => (
        <span style="display:inline-flex;align-items:center;gap:2.5rem;padding:0 2.5rem;font-size:0.7rem;letter-spacing:0.25em;text-transform:uppercase;color:#7A7068;font-family:'Outfit',sans-serif;">
          Landing pages · Sitios corporativos · Prototipos funcionales
          <span style="width:4px;height:4px;border-radius:50%;background:#7D1D3F;display:inline-block;flex-shrink:0;"></span>
          Entrega en 48hs · PageSpeed 95+ · Diseño con carácter
          <span style="width:4px;height:4px;border-radius:50%;background:#7D1D3F;display:inline-block;flex-shrink:0;"></span>
        </span>
      ))}
    </div>
  </div>

</section>

<style>
  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.7); }
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-33.333%); }
  }
</style>
