---
---
<section style="min-height:100dvh;display:flex;flex-direction:column;position:relative;overflow:hidden;padding-top:4rem;">

  <!-- Background video (hidden on mobile) -->
  <video
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
  >
    <source src="/video/hero-bg.mp4" type="video/mp4" />
  </video>

  <!-- Video overlay gradient -->
  <div class="hero-video-overlay" style="position:absolute;inset:0;z-index:1;background:radial-gradient(ellipse at 50% 50%, rgba(10,8,8,0.25) 0%, var(--color-base, #0A0808) 75%), linear-gradient(to bottom, rgba(10,8,8,0.3) 0%, rgba(10,8,8,0.7) 100%);pointer-events:none;"></div>

  <!-- Background radial -->
  <div style="position:absolute;inset:0;z-index:2;background:radial-gradient(ellipse 70% 55% at 65% 35%, rgba(125,29,63,0.2) 0%, transparent 65%);pointer-events:none;"></div>

  <!-- Vertical accent line -->
  <div style="position:absolute;left:2rem;top:0;bottom:0;width:1px;background:linear-gradient(to bottom, transparent 0%, rgba(125,29,63,0.4) 35%, rgba(196,149,106,0.2) 65%, transparent 100%);pointer-events:none;z-index:3;"></div>

  <!-- Main content — margin-top:auto lo empuja al fondo del flex container -->
  <div style="margin-top:auto;padding:0 2rem 3rem;max-width:72rem;width:100%;position:relative;z-index:3;">

    <!-- Eyebrow pill badge -->
    <div class="hero-reveal" style="display:inline-flex;align-items:center;gap:0.5rem;border-radius:9999px;border:1px solid rgba(196,149,106,0.3);background:rgba(196,149,106,0.07);padding:0.35rem 0.9rem;margin-bottom:2rem;width:fit-content;">
      <span style="width:5px;height:5px;border-radius:50%;background:#C4956A;display:inline-block;animation:pulse-dot 2s infinite;flex-shrink:0;"></span>
      <span style="font-size:0.7rem;letter-spacing:0.2em;text-transform:uppercase;color:#C4956A;font-family:'Outfit',sans-serif;font-weight:500;white-space:nowrap;">Diseño & Desarrollo web</span>
    </div>

    <!-- Headline -->
    <h1 class="hero-reveal hero-delay-1" style="font-size:clamp(2.8rem,7.5vw,6.8rem);font-weight:500;color:#F2EDE6;max-width:15ch;margin-bottom:1.75rem;letter-spacing:-0.03em;line-height:1.08;">
      Tu negocio merece una buena
      <em style="color:#7D1D3F;font-style:italic;display:block;">casa en internet.</em>
    </h1>

    <!-- Subheadline -->
    <p class="hero-reveal hero-delay-2" style="font-size:clamp(0.95rem,1.4vw,1.15rem);color:#C8C0B5;max-width:46ch;line-height:1.75;margin-bottom:3rem;font-family:'Outfit',sans-serif;font-weight:300;">
      Diseño y desarrollo de sitios web que convierten visitas en clientes.
      Rápido, con criterio, sin aspecto genérico.
    </p>

    <!-- CTAs -->
    <div class="hero-reveal hero-delay-3" style="display:flex;align-items:center;gap:1.25rem;flex-wrap:wrap;margin-bottom:4rem;">
      <a
        href="#contacto"
        style="display:inline-flex;align-items:center;gap:0.6rem;background:#7D1D3F;color:#F2EDE6;text-decoration:none;padding:0.9rem 1.75rem;border-radius:9999px;font-size:0.82rem;letter-spacing:0.06em;text-transform:uppercase;font-weight:500;font-family:'Outfit',sans-serif;transition:all 0.4s cubic-bezier(0.32,0.72,0,1);"
        onmouseover="this.style.background='#A3264F';this.style.transform='scale(0.97)'"
        onmouseout="this.style.background='#7D1D3F';this.style.transform='scale(1)'"
      >
        Ver qué puedo hacer por vos
        <span style="display:inline-flex;align-items:center;justify-content:center;width:1.5rem;height:1.5rem;border-radius:50%;background:rgba(255,255,255,0.15);font-size:0.7rem;">↗</span>
      </a>
      <a
        href="#proceso"
        style="color:#C8C0B5;text-decoration:none;font-size:0.82rem;letter-spacing:0.08em;text-transform:uppercase;font-family:'Outfit',sans-serif;display:flex;align-items:center;gap:0.4rem;transition:all 0.3s cubic-bezier(0.32,0.72,0,1);"
        onmouseover="this.style.color=document.documentElement.dataset.theme==='light'?'#1A1412':'#F2EDE6';this.style.gap='0.7rem'"
        onmouseout="this.style.color=document.documentElement.dataset.theme==='light'?'#5A4F45':'#C8C0B5';this.style.gap='0.4rem'"
      >
        Cómo trabajo <span>→</span>
      </a>
    </div>

    <!-- Stats -->
    <div class="hero-reveal hero-delay-4" style="display:flex;gap:0;border-top:1px solid rgba(125,29,63,0.2);flex-wrap:wrap;">
      {[
        { valor: 48, sufijo: "hs", label: "Primera versión lista" },
        { valor: 95, sufijo: "+", label: "PageSpeed score" },
        { valor: 100, sufijo: "%", label: "Diseño a medida" },
      ].map((stat, i) => (
        <div style={`padding:1.5rem 2.5rem;${i > 0 ? 'border-left:1px solid rgba(125,29,63,0.2);' : ''}`}>
          <p style="font-family:'Playfair Display',serif;font-size:2rem;font-weight:500;color:#F2EDE6;line-height:1;">
            <span class="stat-counter" data-target={stat.valor} data-suffix={stat.sufijo}>0{stat.sufijo}</span>
          </p>
          <p style="font-size:0.68rem;letter-spacing:0.12em;text-transform:uppercase;color:#7A7068;margin-top:0.4rem;font-family:'Outfit',sans-serif;">
            {stat.label}
          </p>
        </div>
      ))}
    </div>

  </div>

  <!-- Marquee strip — siempre al pie de la sección -->
  <div style="width:100%;border-top:1px solid rgba(125,29,63,0.2);border-bottom:1px solid rgba(125,29,63,0.2);padding:0.85rem 0;overflow:hidden;background:rgba(125,29,63,0.04);flex-shrink:0;position:relative;z-index:3;">
    <div class="marquee-track" style="display:flex;gap:0;white-space:nowrap;width:max-content;animation:marquee 22s linear infinite;">
      {Array(3).fill(null).map(() => (
        <span style="display:inline-flex;align-items:center;gap:2.5rem;padding:0 2.5rem;font-size:0.7rem;letter-spacing:0.25em;text-transform:uppercase;color:#7A7068;font-family:'Outfit',sans-serif;">
          Landing pages · Sitios corporativos · Prototipos funcionales
          <span style="width:4px;height:4px;border-radius:50%;background:#7D1D3F;display:inline-block;flex-shrink:0;"></span>
          Entrega en 48hs · PageSpeed 95+ · Diseño con carácter
          <span style="width:4px;height:4px;border-radius:50%;background:#7D1D3F;display:inline-block;flex-shrink:0;"></span>
        </span>
      ))}
    </div>
  </div>

</section>

<style>
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    opacity: 0.55;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .hero-video {
      display: none;
    }
  }

  :global([data-theme="light"]) .hero-video,
  :global([data-theme="light"]) .hero-video-overlay {
    display: none;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.7); }
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-33.333%); }
  }

  /* Hero auto-reveal — triggers on page load, no IntersectionObserver needed */
  .hero-reveal {
    opacity: 0;
    transform: translateY(36px);
    animation: heroFadeIn 0.85s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-delay-1 { animation-delay: 0.12s; }
  .hero-delay-2 { animation-delay: 0.24s; }
  .hero-delay-3 { animation-delay: 0.38s; }
  .hero-delay-4 { animation-delay: 0.52s; }

  @keyframes heroFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script is:inline>
  (function() {
    var counters = document.querySelectorAll('.stat-counter');
    var animated = false;

    function animateCounters() {
      if (animated) return;
      animated = true;

      counters.forEach(function(el) {
        var target = parseInt(el.getAttribute('data-target'));
        var suffix = el.getAttribute('data-suffix') || '';
        var duration = 1800;
        var start = performance.now();

        function easeOutExpo(t) {
          return t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
        }

        function update(now) {
          var elapsed = now - start;
          var progress = Math.min(elapsed / duration, 1);
          var eased = easeOutExpo(progress);
          var current = Math.round(eased * target);
          el.textContent = current + suffix;
          if (progress < 1) requestAnimationFrame(update);
        }

        requestAnimationFrame(update);
      });
    }

    // Start counters after hero animation finishes (~0.52s delay + 0.85s animation)
    setTimeout(animateCounters, 1400);
  })();
</script>
