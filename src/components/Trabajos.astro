---
const trabajos = [
  {
    numero: "01",
    titulo: "Atom Amoblamiento",
    descripcion: "Landing para fabricante de muebles a medida en Rosario. Galería por categorías, video de marca y contacto directo vía WhatsApp.",
    tags: ["Landing Page", "Carpintería"],
    tipo: "Cliente",
    url: "https://nerybenincasa.github.io/atom.amoblamiento.copia/",
    imagen: "/trabajos/atom.webp",
    acento: "#8B5E3C",
    bg: "rgba(139,94,60,0.07)",
  },
  {
    numero: "02",
    titulo: "De Buena Madera",
    descripcion: "Concepto de sitio para vinería & charcutería. Diseño oscuro y elegante con carta, historia de marca y sistema de reservas.",
    tags: ["Landing Page", "Gastronomía"],
    tipo: "Concepto",
    url: "https://nerybenincasa.github.io/vineria-de-buena-madera/",
    imagen: "/trabajos/debuenamadera.webp",
    acento: "#C9A84C",
    bg: "rgba(201,168,76,0.07)",
  },
  {
    numero: "03",
    titulo: "Puente Sur",
    descripcion: "Concepto de sitio corporativo para empresa de agro. Hero de alto impacto, propuesta de valor clara y formulario de captación.",
    tags: ["Sitio Corporativo", "Agro"],
    tipo: "Concepto",
    url: "https://nerybenincasa.github.io/puente-sur/",
    imagen: "/trabajos/puentesur.webp",
    acento: "#4A7FA5",
    bg: "rgba(74,127,165,0.07)",
  },
];
---

<section id="trabajos" style="padding:clamp(5rem,8vw,7rem) 2rem;position:relative;">

  <div style="position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(to right, transparent, rgba(125,29,63,0.35), transparent);"></div>

  <div style="max-width:72rem;margin:0 auto;">

    <!-- Header -->
    <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;margin-bottom:4rem;flex-wrap:wrap;">
      <div>
        <div class="reveal" style="display:inline-flex;align-items:center;gap:0.5rem;border-radius:9999px;border:1px solid rgba(196,149,106,0.3);background:rgba(196,149,106,0.07);padding:0.35rem 0.9rem;margin-bottom:1.25rem;">
          <span style="font-size:0.7rem;letter-spacing:0.2em;text-transform:uppercase;color:#C4956A;font-family:'Outfit',sans-serif;font-weight:500;">Trabajos</span>
        </div>
        <h2 class="reveal reveal-delay-1" style="font-size:clamp(2rem,3.8vw,3rem);font-weight:500;color:#F2EDE6;letter-spacing:-0.025em;line-height:1.1;">
          Lo que construyo<br/>se ve así
        </h2>
      </div>
      <p class="reveal reveal-delay-2" style="color:#C8C0B5;font-size:0.95rem;line-height:1.75;font-weight:300;font-family:'Outfit',sans-serif;max-width:36ch;">
        Proyectos reales y conceptos. Cada uno construido desde cero, con diseño a medida y enfoque en conversión.
      </p>
    </div>

    <!-- Grilla de proyectos -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(125,29,63,0.15);" class="trabajos-grid">
      {trabajos.map((t, i) => (
        <a
          href={t.url}
          target="_blank"
          rel="noopener"
          class={`reveal-scale reveal-delay-${i + 1} trabajo-card`}
          style={`display:flex;flex-direction:column;background:#0D0A0A;text-decoration:none;position:relative;overflow:hidden;transition:background 0.3s;`}
        >
          <!-- Accent top line -->
          <div style={`position:absolute;top:0;left:0;right:0;height:2px;background:${t.acento};transform:scaleX(0);transform-origin:left;transition:transform 0.4s cubic-bezier(0.32,0.72,0,1);`}
            class="accent-line"></div>

          <!-- Screenshot preview -->
          <div class="trabajo-preview" style={`position:relative;aspect-ratio:16/10;overflow:hidden;background:linear-gradient(135deg, ${t.bg.replace('0.07', '0.15')}, #0D0A0A 70%);`}>
            <img
              src={t.imagen}
              alt={`Preview de ${t.titulo}`}
              loading="lazy"
              style="width:100%;height:100%;object-fit:cover;object-position:top;transition:transform 0.6s cubic-bezier(0.32,0.72,0,1);"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
            />
            <!-- Fallback gradient si no hay imagen -->
            <div style={`display:none;position:absolute;inset:0;background:linear-gradient(135deg, ${t.bg.replace('0.07', '0.12')}, rgba(13,10,10,0.95));align-items:center;justify-content:center;flex-direction:column;gap:0.5rem;`}>
              <span style={`font-family:'Playfair Display',serif;font-size:2rem;color:${t.acento};opacity:0.3;`}>{t.titulo.charAt(0)}</span>
              <span style="font-size:0.65rem;letter-spacing:0.12em;text-transform:uppercase;color:#7A7068;font-family:'Outfit',sans-serif;">Preview</span>
            </div>
            <!-- Overlay gradient for text readability -->
            <div style="position:absolute;bottom:0;left:0;right:0;height:40%;background:linear-gradient(to top, #0D0A0A, transparent);pointer-events:none;"></div>
            <!-- Tipo badge -->
            <span style={`position:absolute;top:0.75rem;right:0.75rem;font-size:0.65rem;letter-spacing:0.1em;text-transform:uppercase;padding:0.3rem 0.7rem;border-radius:9999px;font-family:'Outfit',sans-serif;font-weight:600;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);${t.tipo === 'Cliente' ? `background:rgba(139,94,60,0.55);color:#F2EDE6;border:1px solid rgba(139,94,60,0.6);` : `background:rgba(30,25,25,0.7);color:#C8C0B5;border:1px solid rgba(255,255,255,0.15);`}`}>{t.tipo}</span>
          </div>

          <!-- Content -->
          <div style="padding:1.5rem 2rem 2rem;">
            <!-- Título -->
            <h3 style="font-size:1.25rem;font-weight:500;color:#F2EDE6;letter-spacing:-0.02em;margin-bottom:0.65rem;">{t.titulo}</h3>

            <!-- Descripción -->
            <p style="color:#C8C0B5;font-size:0.85rem;line-height:1.75;font-weight:300;font-family:'Outfit',sans-serif;flex:1;">{t.descripcion}</p>

            <!-- Tags + arrow -->
            <div style="display:flex;align-items:center;justify-content:space-between;margin-top:1.25rem;flex-wrap:wrap;gap:0.5rem;">
              <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                {t.tags.map(tag => (
                  <span style={`font-size:0.6rem;letter-spacing:0.1em;text-transform:uppercase;color:${t.acento};border:1px solid ${t.acento}40;padding:0.2rem 0.55rem;border-radius:9999px;font-family:'Outfit',sans-serif;`}>{tag}</span>
                ))}
              </div>
              <span style={`color:${t.acento};font-size:0.9rem;transition:transform 0.3s;`} class="arrow">↗</span>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  .trabajos-grid a:hover .accent-line {
    transform: scaleX(1) !important;
  }
  .trabajos-grid a:hover .arrow {
    transform: translate(3px, -3px);
  }
  /* Parallax zoom on hover — JS handles transform via mousemove */
  .trabajo-card .trabajo-preview img {
    will-change: transform;
  }
  @media (max-width: 900px) {
    .trabajos-grid {
      grid-template-columns: 1fr !important;
    }
  }
  @media (min-width: 901px) and (max-width: 1100px) {
    .trabajos-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }

  /* Light theme */
  [data-theme="light"] .trabajo-preview div[style*="background:linear-gradient(to top"] {
    background: linear-gradient(to top, #FFFFFF, transparent) !important;
  }
  [data-theme="light"] .trabajo-preview span[style*="background:rgba(30,25,25,0.7)"] {
    background: rgba(255,255,255,0.75) !important;
    border-color: rgba(0,0,0,0.12) !important;
    color: #5A4F45 !important;
  }
</style>

<script is:inline>
  (function() {
    var cards = document.querySelectorAll('.trabajo-card');
    cards.forEach(function(card) {
      var preview = card.querySelector('.trabajo-preview');
      var img = preview ? preview.querySelector('img') : null;
      if (!img) return;

      card.addEventListener('mousemove', function(e) {
        var rect = preview.getBoundingClientRect();
        var x = (e.clientX - rect.left) / rect.width - 0.5;
        var y = (e.clientY - rect.top) / rect.height - 0.5;
        img.style.transform = 'scale(1.08) translate(' + (x * -15) + 'px, ' + (y * -15) + 'px)';
      });

      card.addEventListener('mouseleave', function() {
        img.style.transform = 'scale(1) translate(0, 0)';
      });
    });
  })();
</script>
