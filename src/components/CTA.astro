---
---
<section id="contacto" style="padding:clamp(5rem,10vw,9rem) 2rem;position:relative;overflow:hidden;">

  <!-- Background -->
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse 70% 80% at 50% 50%, rgba(125,29,63,0.15) 0%, transparent 70%);pointer-events:none;"></div>
  <div style="position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(to right, transparent, rgba(125,29,63,0.4), transparent);"></div>

  <div style="max-width:72rem;margin:0 auto;position:relative;">

    <div style="max-width:42rem;margin:0 auto;text-align:center;">
      <div class="reveal" style="display:inline-flex;align-items:center;gap:0.5rem;border-radius:9999px;border:1px solid rgba(196,149,106,0.3);background:rgba(196,149,106,0.07);padding:0.35rem 0.9rem;margin-bottom:1.5rem;">
        <span style="font-size:0.7rem;letter-spacing:0.2em;text-transform:uppercase;color:#C4956A;font-family:'Outfit',sans-serif;font-weight:500;">¿Empezamos?</span>
      </div>

      <h2 class="reveal reveal-delay-1" style="font-size:clamp(2.2rem,5vw,4rem);font-weight:500;color:#F2EDE6;line-height:1.15;margin-bottom:1.5rem;">
        Tu próximo cliente<br/>
        <em style="color:#7D1D3F;">ya te está buscando</em>
      </h2>

      <p class="reveal reveal-delay-2" style="color:#C8C0B5;font-size:1rem;line-height:1.8;font-weight:300;margin-bottom:3rem;">
        En 48 horas podés tener una primera versión funcional de tu sitio para mostrarle a quien quieras.
        Sin compromiso. Sin pagos adelantados. Solo mandame un mensaje y arrancamos.
      </p>

      <!-- Contacto directo -->
      <div class="reveal reveal-delay-2" style="display:flex;justify-content:center;gap:1rem;margin-bottom:2.5rem;flex-wrap:wrap;">
        <a
          href="https://wa.me/543413345345"
          target="_blank"
          rel="noopener"
          style="display:flex;align-items:center;gap:0.6rem;background:#1C1515;border:1px solid rgba(125,29,63,0.4);color:#F2EDE6;text-decoration:none;padding:0.75rem 1.5rem;font-size:0.85rem;letter-spacing:0.06em;transition:all 0.25s;"
          onmouseover="this.style.borderColor='rgba(125,29,63,0.9)';this.style.background=document.documentElement.dataset.theme==='light'?'#F0EBE3':'#2A1515'"
          onmouseout="this.style.borderColor='rgba(125,29,63,0.4)';this.style.background=document.documentElement.dataset.theme==='light'?'#FFFFFF':'#1C1515'"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#C4956A"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.117.554 4.103 1.523 5.826L.057 23.885a.5.5 0 0 0 .606.61l6.218-1.635A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.882a9.875 9.875 0 0 1-5.021-1.368l-.36-.214-3.733.981.999-3.645-.235-.374A9.855 9.855 0 0 1 2.118 12C2.118 6.533 6.533 2.118 12 2.118S21.882 6.533 21.882 12 17.467 21.882 12 21.882z"/></svg>
          WhatsApp
        </a>
        <a
          href="mailto:nerybenincasa@gmail.com"
          style="display:flex;align-items:center;gap:0.6rem;background:#1C1515;border:1px solid rgba(125,29,63,0.4);color:#F2EDE6;text-decoration:none;padding:0.75rem 1.5rem;font-size:0.85rem;letter-spacing:0.06em;transition:all 0.25s;"
          onmouseover="this.style.borderColor='rgba(125,29,63,0.9)';this.style.background=document.documentElement.dataset.theme==='light'?'#F0EBE3':'#2A1515'"
          onmouseout="this.style.borderColor='rgba(125,29,63,0.4)';this.style.background=document.documentElement.dataset.theme==='light'?'#FFFFFF':'#1C1515'"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C4956A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          nerybenincasa@gmail.com
        </a>
      </div>

      <div class="reveal reveal-delay-3" style="display:flex;align-items:center;gap:1rem;margin-bottom:2rem;">
        <div style="flex:1;height:1px;background:linear-gradient(to right, transparent, rgba(125,29,63,0.3));"></div>
        <span style="font-size:0.75rem;letter-spacing:0.15em;text-transform:uppercase;color:#7A7068;">o completá el formulario</span>
        <div style="flex:1;height:1px;background:linear-gradient(to left, transparent, rgba(125,29,63,0.3));"></div>
      </div>

      <!-- Form -->
      <form
        id="lead-form"
        class="reveal reveal-delay-3"
        style="display:flex;flex-direction:column;gap:1rem;text-align:left;"
      >
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;" class="form-grid">
          <div>
            <label style="display:block;font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;color:#7A7068;margin-bottom:0.5rem;">Nombre</label>
            <input
              type="text"
              name="nombre"
              required
              placeholder="Tu nombre"
              style="width:100%;background:#120E0E;border:1px solid rgba(125,29,63,0.3);color:#F2EDE6;padding:0.85rem 1rem;font-family:'Outfit',sans-serif;font-size:0.95rem;outline:none;transition:border-color 0.2s;"
              onfocus="this.style.borderColor='rgba(125,29,63,0.8)'"
              onblur="this.style.borderColor='rgba(125,29,63,0.3)'"
            />
          </div>
          <div>
            <label style="display:block;font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;color:#7A7068;margin-bottom:0.5rem;">Negocio</label>
            <input
              type="text"
              name="negocio"
              placeholder="Nombre del negocio"
              style="width:100%;background:#120E0E;border:1px solid rgba(125,29,63,0.3);color:#F2EDE6;padding:0.85rem 1rem;font-family:'Outfit',sans-serif;font-size:0.95rem;outline:none;transition:border-color 0.2s;"
              onfocus="this.style.borderColor='rgba(125,29,63,0.8)'"
              onblur="this.style.borderColor='rgba(125,29,63,0.3)'"
            />
          </div>
        </div>

        <div>
          <label style="display:block;font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;color:#7A7068;margin-bottom:0.5rem;">Email o WhatsApp</label>
          <input
            type="text"
            name="contacto"
            required
            placeholder="Como prefieras que te contacte"
            style="width:100%;background:#120E0E;border:1px solid rgba(125,29,63,0.3);color:#F2EDE6;padding:0.85rem 1rem;font-family:'Outfit',sans-serif;font-size:0.95rem;outline:none;transition:border-color 0.2s;"
            onfocus="this.style.borderColor='rgba(125,29,63,0.8)'"
            onblur="this.style.borderColor='rgba(125,29,63,0.3)'"
          />
        </div>

        <div>
          <label style="display:block;font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;color:#7A7068;margin-bottom:0.5rem;">Contame sobre tu negocio</label>
          <textarea
            rows="4"
            name="mensaje"
            placeholder="Qué hacés, qué necesitás, qué dudas tenés..."
            style="width:100%;background:#120E0E;border:1px solid rgba(125,29,63,0.3);color:#F2EDE6;padding:0.85rem 1rem;font-family:'Outfit',sans-serif;font-size:0.95rem;outline:none;resize:vertical;transition:border-color 0.2s;"
            onfocus="this.style.borderColor='rgba(125,29,63,0.8)'"
            onblur="this.style.borderColor='rgba(125,29,63,0.3)'"
          ></textarea>
        </div>

        <button
          id="lead-btn"
          type="submit"
          style="background:#7D1D3F;color:#F2EDE6;border:none;padding:1rem 2rem;font-family:'Outfit',sans-serif;font-size:0.85rem;letter-spacing:0.1em;text-transform:uppercase;font-weight:500;cursor:pointer;transition:background 0.3s ease;margin-top:0.5rem;"
          onmouseover="this.style.background='#A3264F'"
          onmouseout="this.style.background='#7D1D3F'"
        >
          Quiero mi sitio web
        </button>
      </form>

      <script>
        const GOOGLE_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbyB8NdUvGbMm1CxjWz5T1OgOXCn8XuePQeVr5GKQWTwvhSbS8kTy0MXNjbo11FP_8PS/exec';

        document.getElementById('lead-form')?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const form = e.target as HTMLFormElement;
          const btn = document.getElementById('lead-btn') as HTMLButtonElement;
          const data = Object.fromEntries(new FormData(form));

          btn.textContent = 'Enviando...';
          btn.disabled = true;

          try {
            // Enviar a Google Sheets
            await fetch(GOOGLE_SCRIPT_URL, {
              method: 'POST',
              mode: 'no-cors',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data),
            });

            // También enviar email via FormSubmit
            const emailForm = new FormData();
            emailForm.append('nombre', data.nombre as string);
            emailForm.append('negocio', data.negocio as string);
            emailForm.append('contacto', data.contacto as string);
            emailForm.append('mensaje', data.mensaje as string);
            emailForm.append('_subject', 'Nuevo contacto desde Benincasa.com');
            emailForm.append('_captcha', 'false');
            emailForm.append('_template', 'table');

            await fetch('https://formsubmit.co/ajax/nerybenincasa@gmail.com', {
              method: 'POST',
              body: emailForm,
            });

            window.location.href = '/gracias';
          } catch {
            window.location.href = '/gracias';
          }
        });
      </script>
    </div>
  </div>
</section>

<style>
  @media (max-width: 600px) {
    .form-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
