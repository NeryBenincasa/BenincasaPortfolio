---
---
<header
  id="nav"
  style="position:fixed;top:0;left:0;right:0;z-index:50;background:rgba(10,8,8,0.85);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid rgba(125,29,63,0.2);padding:0 2rem;height:4rem;display:flex;align-items:center;justify-content:space-between;transition:background 0.3s ease;"
>
  <div style="max-width:72rem;width:100%;margin:0 auto;display:flex;align-items:center;justify-content:space-between;">

    <!-- Logo -->
    <a
      href="/"
      class="nav-logo"
      style="font-family:'Playfair Display',serif;font-size:1.05rem;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;color:#F2EDE6;text-decoration:none;transition:color 0.2s;flex-shrink:0;"
      onmouseover="this.style.color='#C4956A'"
      onmouseout="this.style.color=document.documentElement.dataset.theme==='light'?'#1A1412':'#F2EDE6'"
    >
      Benincasa
    </a>

    <!-- Desktop nav -->
    <nav class="nav-desktop" style="display:flex;align-items:center;gap:2rem;">
      <a href="#servicios" class="nav-link" style="font-size:0.78rem;letter-spacing:0.1em;text-transform:uppercase;color:#C8C0B5;text-decoration:none;transition:color 0.25s;" onmouseover="this.style.color=document.documentElement.dataset.theme==='light'?'#1A1412':'#F2EDE6'" onmouseout="this.style.color=document.documentElement.dataset.theme==='light'?'#5A4F45':'#C8C0B5'">Servicios</a>
      <a href="#proceso" class="nav-link" style="font-size:0.78rem;letter-spacing:0.1em;text-transform:uppercase;color:#C8C0B5;text-decoration:none;transition:color 0.25s;" onmouseover="this.style.color=document.documentElement.dataset.theme==='light'?'#1A1412':'#F2EDE6'" onmouseout="this.style.color=document.documentElement.dataset.theme==='light'?'#5A4F45':'#C8C0B5'">Proceso</a>

      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        onclick="toggleTheme()"
        aria-label="Cambiar tema claro/oscuro"
        style="background:none;border:1px solid rgba(125,29,63,0.3);color:#C8C0B5;width:2.2rem;height:2.2rem;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all 0.3s ease;flex-shrink:0;"
        onmouseover="this.style.borderColor='rgba(196,149,106,0.5)';this.style.color='#C4956A'"
        onmouseout="this.style.borderColor='rgba(125,29,63,0.35)';this.style.color=document.documentElement.dataset.theme==='light'?'#5A4F45':'#C8C0B5'"
      >
        <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <a
        href="#contacto"
        style="display:flex;align-items:center;gap:0.5rem;font-size:0.78rem;letter-spacing:0.1em;text-transform:uppercase;color:#F2EDE6;text-decoration:none;background:#7D1D3F;padding:0.55rem 1.25rem;border-radius:9999px;transition:all 0.35s cubic-bezier(0.32,0.72,0,1);"
        onmouseover="this.style.background='#A3264F';this.style.transform='scale(0.97)'"
        onmouseout="this.style.background='#7D1D3F';this.style.transform='scale(1)'"
      >
        Hablemos
        <span style="display:inline-flex;align-items:center;justify-content:center;width:1.2rem;height:1.2rem;border-radius:50%;background:rgba(255,255,255,0.12);font-size:0.65rem;">↗</span>
      </a>
    </nav>

    <!-- Mobile: theme toggle + hamburger -->
    <div class="nav-mobile-buttons" style="display:none;align-items:center;gap:0.75rem;">
      <button
        id="theme-toggle-mobile"
        onclick="toggleTheme()"
        aria-label="Cambiar tema claro/oscuro"
        style="background:none;border:1px solid rgba(125,29,63,0.3);color:#C8C0B5;width:2.2rem;height:2.2rem;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all 0.3s ease;flex-shrink:0;"
      >
        <svg class="icon-sun-m" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="icon-moon-m" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <button
        id="hamburger"
        aria-label="Abrir menú"
        style="background:none;border:none;color:#F2EDE6;cursor:pointer;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:5px;width:2.2rem;height:2.2rem;padding:0;"
      >
        <span class="hamburger-line" style="display:block;width:20px;height:1.5px;background:#F2EDE6;transition:all 0.3s ease;transform-origin:center;"></span>
        <span class="hamburger-line" style="display:block;width:20px;height:1.5px;background:#F2EDE6;transition:all 0.3s ease;"></span>
        <span class="hamburger-line" style="display:block;width:14px;height:1.5px;background:#F2EDE6;transition:all 0.3s ease;transform-origin:center;margin-left:0;align-self:flex-start;margin-left:5px;"></span>
      </button>
    </div>

  </div>
</header>

<!-- Mobile menu overlay -->
<div id="mobile-menu" class="mobile-menu-overlay">
  <nav class="mobile-menu-nav">
    <a href="#servicios" class="mobile-menu-link">Servicios</a>
    <a href="#trabajos" class="mobile-menu-link">Trabajos</a>
    <a href="#proceso" class="mobile-menu-link">Proceso</a>
    <a href="#sobre-mi" class="mobile-menu-link">Sobre mí</a>
    <a href="#faq" class="mobile-menu-link">FAQ</a>
    <div style="width:3rem;height:1px;background:rgba(125,29,63,0.4);margin:0.5rem auto;"></div>
    <a href="#contacto" class="mobile-menu-link mobile-menu-cta">
      Hablemos
      <span style="display:inline-flex;align-items:center;justify-content:center;width:1.4rem;height:1.4rem;border-radius:50%;background:rgba(255,255,255,0.15);font-size:0.7rem;">↗</span>
    </a>
  </nav>
</div>

<style>
  @media (max-width: 768px) {
    .nav-desktop {
      display: none !important;
    }
    .nav-mobile-buttons {
      display: flex !important;
    }
  }

  /* Hamburger open state */
  #hamburger.open .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(4.5px, 4.5px);
  }
  #hamburger.open .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #hamburger.open .hamburger-line:nth-child(3) {
    width: 20px !important;
    margin-left: 0 !important;
    align-self: center !important;
    transform: rotate(-45deg) translate(4.5px, -4.5px);
  }

  /* Mobile menu — full viewport */
  .mobile-menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    z-index: 49;
    background: rgba(10,8,8,0.97);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s cubic-bezier(0.32,0.72,0,1);
    overflow-y: auto;
  }

  .mobile-menu-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100%;
    padding: 5rem 2rem 3rem;
    gap: 1.5rem;
  }

  .mobile-menu-link {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.4rem, 5vw, 1.75rem);
    font-weight: 500;
    color: #F2EDE6;
    text-decoration: none;
    letter-spacing: -0.02em;
    transform: translateY(20px);
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.32,0.72,0,1);
  }

  .mobile-menu-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #7D1D3F;
    color: #F2EDE6 !important;
    padding: 0.9rem 2rem;
    border-radius: 9999px;
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 500;
  }

  /* Mobile menu open */
  .mobile-menu-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu-overlay.open .mobile-menu-link {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-menu-overlay.open .mobile-menu-link:nth-child(1) { transition-delay: 0.05s; }
  .mobile-menu-overlay.open .mobile-menu-link:nth-child(2) { transition-delay: 0.1s; }
  .mobile-menu-overlay.open .mobile-menu-link:nth-child(3) { transition-delay: 0.15s; }
  .mobile-menu-overlay.open .mobile-menu-link:nth-child(4) { transition-delay: 0.2s; }
  .mobile-menu-overlay.open .mobile-menu-link:nth-child(5) { transition-delay: 0.25s; }
  .mobile-menu-overlay.open .mobile-menu-link:nth-child(7) { transition-delay: 0.35s; }

  /* Light theme overrides for mobile menu */
  [data-theme="light"] .mobile-menu-overlay {
    background: rgba(245,240,232,0.97) !important;
  }
  [data-theme="light"] .mobile-menu-link {
    color: #1A1412 !important;
  }
  [data-theme="light"] .mobile-menu-cta {
    color: #F2EDE6 !important;
  }
  [data-theme="light"] .hamburger-line {
    background: #1A1412 !important;
  }
</style>

<script>
  // Theme toggle icons + nav color sync
  function updateToggleIcons() {
    const theme = document.documentElement.getAttribute('data-theme');
    const isLight = theme === 'light';
    const icons = [
      { sun: '.icon-sun', moon: '.icon-moon' },
      { sun: '.icon-sun-m', moon: '.icon-moon-m' },
    ];
    icons.forEach(({ sun, moon }) => {
      const sunEl = document.querySelector(sun) as HTMLElement;
      const moonEl = document.querySelector(moon) as HTMLElement;
      if (sunEl) sunEl.style.display = theme === 'dark' ? 'block' : 'none';
      if (moonEl) moonEl.style.display = theme === 'light' ? 'block' : 'none';
    });

    // Sync nav element colors to current theme
    const logo = document.querySelector('.nav-logo') as HTMLElement;
    if (logo) logo.style.color = isLight ? '#1A1412' : '#F2EDE6';

    document.querySelectorAll<HTMLElement>('.nav-link').forEach(el => {
      el.style.color = isLight ? '#5A4F45' : '#C8C0B5';
    });

    const toggles = [document.getElementById('theme-toggle'), document.getElementById('theme-toggle-mobile')];
    toggles.forEach(btn => {
      if (btn) {
        btn.style.color = isLight ? '#5A4F45' : '#C8C0B5';
        btn.style.borderColor = 'rgba(125,29,63,0.35)';
      }
    });
  }

  updateToggleIcons();

  const obs = new MutationObserver(updateToggleIcons);
  obs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  // Hamburger menu
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');

  hamburger?.addEventListener('click', () => {
    hamburger.classList.toggle('open');
    mobileMenu?.classList.toggle('open');
    document.body.style.overflow = mobileMenu?.classList.contains('open') ? 'hidden' : '';
  });

  // Close menu on link click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      hamburger?.classList.remove('open');
      mobileMenu?.classList.remove('open');
      document.body.style.overflow = '';
    });
  });
</script>
