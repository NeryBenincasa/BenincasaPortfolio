---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noIndex?: boolean;
}

const {
  title = "Benincasa — Tu negocio merece una buena casa en internet",
  description = "Diseño y desarrollo de sitios web que convierten visitas en clientes. Rápido, con criterio, sin aspecto genérico. Primera versión en 48 horas.",
  ogImage = "/og-image.png",
  canonical = "https://benincasa.dev",
  noIndex = false,
} = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "Benincasa",
      "url": canonical,
      "description": description,
      "inLanguage": "es-AR"
    },
    {
      "@type": "ProfessionalService",
      "name": "Benincasa",
      "url": canonical,
      "description": "Diseño y desarrollo de sitios web que convierten visitas en clientes.",
      "founder": {
        "@type": "Person",
        "name": "Nery Benincasa"
      },
      "areaServed": {
        "@type": "Country",
        "name": "Argentina"
      },
      "serviceType": ["Diseño Web", "Desarrollo Web", "Landing Pages", "Sitios Corporativos", "Prototipo de Producto"],
      "priceRange": "$250–$600 USD",
      "email": "nerybenincasa@gmail.com",
      "telephone": "+54-341-334-5345",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Rosario",
        "addressRegion": "Santa Fe",
        "addressCountry": "AR"
      }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" id="meta-color-scheme" />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Nery Benincasa" />
    {noIndex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph (WhatsApp, Facebook, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${canonical}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Benincasa — Tu negocio merece una buena casa en internet" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Benincasa" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${canonical}${ogImage}`} />

    <!-- Theme color (mobile browser chrome) -->
    <meta name="theme-color" content="#7D1D3F" id="meta-theme" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- DNS prefetch -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="dns-prefetch" href="https://formsubmit.co" />

    <!-- Fonts — preconnect + preload critical weights -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Outfit:wght@300;400;500;600&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Outfit:wght@300;400;500;600&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />

    <!-- Prevent FOUC: apply saved theme before render -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
          const meta = document.getElementById('meta-theme');
          if (meta) meta.setAttribute('content', '#F5F0E8');
        }
      })();
    </script>
  </head>
  <body class="noise">
    <!-- Page transition overlay -->
    <div id="page-transition" style="position:fixed;inset:0;z-index:9999;background:#0A0808;pointer-events:none;opacity:1;transition:opacity 0.6s cubic-bezier(0.16,1,0.3,1);"></div>

    <slot />

    <script>
      // Vercel Analytics
      import { inject } from '@vercel/analytics';
      inject();
    </script>

    <script is:inline>
      // Reveal animations — init after DOM is ready
      function initReveals() {
        var sel = '.reveal, .reveal-left, .reveal-right, .reveal-scale, .reveal-rotate';
        var els = document.querySelectorAll(sel);
        if (!els.length) return;

        var observer = new IntersectionObserver(
          function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.05, rootMargin: '50px 0px -40px 0px' }
        );

        els.forEach(function(el) { observer.observe(el); });

        // Fallback for fast scroll / anchor jumps
        function revealPassed() {
          document.querySelectorAll(sel).forEach(function(el) {
            if (!el.classList.contains('visible')) {
              var rect = el.getBoundingClientRect();
              if (rect.bottom < window.innerHeight + 150) {
                el.classList.add('visible');
              }
            }
          });
        }
        window.addEventListener('scroll', revealPassed, { passive: true });
      }

      // Run on multiple events to ensure it catches
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initReveals);
      } else {
        initReveals();
      }
      window.addEventListener('load', initReveals);

      // Theme toggle
      window.toggleTheme = function() {
        var html = document.documentElement;
        var current = html.getAttribute('data-theme');
        var next = current === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        var meta = document.getElementById('meta-theme');
        if (meta) meta.setAttribute('content', next === 'dark' ? '#7D1D3F' : '#F5F0E8');
      };

      // Page transition — fade in on load
      var overlay = document.getElementById('page-transition');
      if (overlay) {
        window.addEventListener('load', function() {
          overlay.style.opacity = '0';
          setTimeout(function() { overlay.style.display = 'none'; }, 600);
        });
        // Also fade in quickly if load already fired
        if (document.readyState === 'complete') {
          overlay.style.opacity = '0';
          setTimeout(function() { overlay.style.display = 'none'; }, 600);
        }
      }

      // Fade out on external navigation (non-anchor links)
      document.addEventListener('click', function(e) {
        var link = e.target.closest('a[href]');
        if (!link) return;
        var href = link.getAttribute('href');
        // Skip anchors, external links, and special links
        if (!href || href.startsWith('#') || href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('tel:') || link.target === '_blank') return;

        e.preventDefault();
        var ov = document.getElementById('page-transition');
        if (ov) {
          ov.style.display = 'block';
          ov.style.opacity = '1';
          setTimeout(function() { window.location.href = href; }, 400);
        } else {
          window.location.href = href;
        }
      });
    </script>
  </body>
</html>
