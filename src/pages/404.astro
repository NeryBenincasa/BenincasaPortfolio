---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Página no encontrada — Benincasa"
  description="La página que buscás no existe."
  noIndex={true}
>
  <section style="min-height:100dvh;display:flex;align-items:center;justify-content:center;padding:2rem;text-align:center;">

    <div style="position:absolute;inset:0;background:radial-gradient(ellipse 60% 50% at 50% 45%, rgba(125,29,63,0.12) 0%, transparent 70%);pointer-events:none;"></div>

    <div style="position:relative;max-width:36rem;">
      <p style="font-family:'Playfair Display',serif;font-size:clamp(5rem,12vw,8rem);font-weight:500;color:rgba(125,29,63,0.3);line-height:1;margin-bottom:1.5rem;">404</p>

      <h1 style="font-size:clamp(1.5rem,3vw,2.2rem);font-weight:500;color:#F2EDE6;margin-bottom:1rem;letter-spacing:-0.02em;">
        Esta página no existe
      </h1>

      <p style="color:#C8C0B5;font-size:1rem;line-height:1.75;font-weight:300;font-family:'Outfit',sans-serif;margin-bottom:2.5rem;">
        Puede que el enlace esté roto o la dirección haya cambiado. Pero tu negocio sí puede tener una buena casa en internet.
      </p>

      <a
        href="/"
        style="display:inline-flex;align-items:center;gap:0.6rem;background:#7D1D3F;color:#F2EDE6;text-decoration:none;padding:0.9rem 1.75rem;border-radius:9999px;font-size:0.82rem;letter-spacing:0.06em;text-transform:uppercase;font-weight:500;font-family:'Outfit',sans-serif;transition:all 0.4s cubic-bezier(0.32,0.72,0,1);"
        onmouseover="this.style.background='#A3264F';this.style.transform='scale(0.97)'"
        onmouseout="this.style.background='#7D1D3F';this.style.transform='scale(1)'"
      >
        Volver al inicio
        <span style="display:inline-flex;align-items:center;justify-content:center;width:1.5rem;height:1.5rem;border-radius:50%;background:rgba(255,255,255,0.15);font-size:0.7rem;">←</span>
      </a>
    </div>

  </section>
</Layout>
